# Copy this file to .env for local development (never commit the real .env).
# On Posit Connect, set these as the app's real Environment Variables instead.

# Google Sheet used as the Stage 1 data store (see plan for the sheet ID).
CEIRIOG_SHEET_ID=

# Full contents of a Google service account key JSON file, as one value.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cloudinary REST API credentials (cloud name "xflukfs5" is not secret, so it
# lives in R/config.R rather than here).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared password that unlocks the app's Edit tab.
EDIT_PASSWORD=
